{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiz-generator",
  "main": "./.cloudflare/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./.cloudflare/public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quiz-generator-db",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCS_BUCKET",
      "bucket_name": "quiz-generator-docs"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // Vectorize index for chunk embeddings (@cf/baai/bge-m3, 1024-dim).
  // The index + metadata indexes must be created once against your Cloudflare
  // account before deploying (metadata indexes MUST exist before vectors are
  // inserted for filtering to work):
  //   wrangler vectorize create quiz-generator-chunks --dimensions=1024 --metric=cosine
  //   wrangler vectorize create-metadata-index quiz-generator-chunks --property-name=user_id --type=string
  //   wrangler vectorize create-metadata-index quiz-generator-chunks --property-name=document_id --type=string
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "quiz-generator-chunks"
    }
  ]
}
