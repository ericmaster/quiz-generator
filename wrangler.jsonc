{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiz-generator",
  "main": "./.cloudflare/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./.cloudflare/public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quiz-generator-db",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCS_BUCKET",
      "bucket_name": "quiz-generator-docs"
    }
  ]
}
